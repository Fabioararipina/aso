DB_DATABASE=
DB_PASSWORD=
DB_PORT=5432

# Autenticação JWT — OBRIGATÓRIO: gere uma chave aleatória forte
# Exemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
