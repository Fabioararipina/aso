# Configurações da Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_aqui
EVOLUTION_INSTANCE_NAME=clinica-essencial
APP_PUBLIC_URL=http://localhost:5000 # ou seu domínio público, ex: https://api.seusistema.com

# Configurações do Banco de Dados
DB_USER=
