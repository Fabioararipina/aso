# ASO Saúde — Backend Configuration
# Copy this file to .env and fill in the values

# Database (PostgreSQL)
DATABASE_URL=postgresql://aso_user:aso_pass@localhost:5432/aso_saude
# Alternative: individual fields (used if DATABASE_URL is not set)
# DB_USER=aso_user
# DB_HOST=localhost
# DB_DATABASE=aso_saude
# DB_PASSWORD=aso_pass
# DB_PORT=5432

# Authentication JWT — generate a strong random key:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=seu_jwt_secret_aqui

# Server port
PORT=3001

# WhatsApp via Baileys — set to false to disable WA messages in dev
WHATSAPP_ENABLED=true

# Environment
NODE_ENV=development
